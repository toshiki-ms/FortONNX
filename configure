#!/bin/sh
set -eu

fc=${FC:-gfortran}
cc=${CC:-cc}
backend=${BACKEND:-cpu}
prefix=${PREFIX:-/usr/local}
ort_root=${ONNXRUNTIME_ROOT:-}
ort_include=${ONNXRUNTIME_INCLUDE:-}
ort_libdir=${ONNXRUNTIME_LIBDIR:-}
ort_library=${ONNXRUNTIME_LIBRARY:-}
ort_soname=${ONNXRUNTIME_SONAME:-}
runtime_library_path=${RUNTIME_LIBRARY_PATH:-}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --fc) fc=$2; shift 2 ;;
    --cc) cc=$2; shift 2 ;;
    --backend) backend=$2; shift 2 ;;
    --prefix) prefix=$2; shift 2 ;;
    --onnxruntime-root) ort_root=$2; shift 2 ;;
    --onnxruntime-include) ort_include=$2; shift 2 ;;
    --onnxruntime-libdir) ort_libdir=$2; shift 2 ;;
    --onnxruntime-library) ort_library=$2; shift 2 ;;
    --runtime-library-path) runtime_library_path=$2; shift 2 ;;
    --help)
      printf '%s\n' 'usage: ./configure [--fc COMPILER] [--cc COMPILER]' \
        '  [--backend cpu|cuda|tensorrt] [--onnxruntime-root PATH]' \
        '  [--onnxruntime-include PATH] [--onnxruntime-libdir PATH]' \
        '  [--onnxruntime-library PATH]' \
        '  [--runtime-library-path PATH[:PATH...]]' \
        '  [--prefix PATH]'
      exit 0 ;;
    *) printf 'configure: unknown option: %s\n' "$1" >&2; exit 2 ;;
  esac
done

fc_base=$(basename "${fc%% *}")
case "$fc_base" in
  gfortran|flang|ifx|nvfortran) ;;
  *)
    printf 'configure: unsupported Fortran compiler: %s\n' "$fc_base" >&2
    printf '%s\n' 'choose gfortran, flang, ifx, or nvfortran' >&2
    exit 2 ;;
esac
case "$backend" in
  cpu|cuda|tensorrt) ;;
  *) printf 'configure: backend must be cpu, cuda, or tensorrt\n' >&2; exit 2 ;;
esac
if ! command -v "${fc%% *}" >/dev/null 2>&1; then
  printf 'configure: compiler not found: %s\n' "${fc%% *}" >&2
  exit 2
fi

if [ -n "$ort_root" ]; then
  if [ -z "$ort_include" ] && [ -f "$ort_root/include/onnxruntime_c_api.h" ]; then
    ort_include=$ort_root/include
  fi
  if [ -z "$ort_libdir" ]; then
    for candidate in "$ort_root/lib" "$ort_root/lib64"; do
      if find "$candidate" -maxdepth 1 -name 'libonnxruntime.so*' -print -quit 2>/dev/null | grep -q .; then
        ort_libdir=$candidate
        break
      fi
    done
  fi
fi

if [ -z "$ort_include" ] && [ -n "${CONDA_PREFIX:-}" ]; then
  for candidate in "$CONDA_PREFIX/include" "$CONDA_PREFIX/include/onnxruntime"; do
    if [ -f "$candidate/onnxruntime_c_api.h" ]; then
      ort_include=$candidate
      break
    fi
  done
fi
if [ -z "$ort_libdir" ] && command -v python >/dev/null 2>&1; then
  detected=$(python -c 'import pathlib, onnxruntime; print(pathlib.Path(onnxruntime.__file__).parent / "capi")' 2>/dev/null || true)
  if [ -n "$detected" ] && find "$detected" -maxdepth 1 -name 'libonnxruntime.so*' -print -quit 2>/dev/null | grep -q .; then
    ort_libdir=$detected
  fi
fi

if [ -z "$ort_library" ] && [ -n "$ort_libdir" ]; then
  if [ -f "$ort_libdir/libonnxruntime.so" ]; then
    ort_library=$ort_libdir/libonnxruntime.so
  else
    ort_library=$(find "$ort_libdir" -maxdepth 1 -name 'libonnxruntime.so.*' -print -quit 2>/dev/null || true)
  fi
fi

if [ -z "$ort_include" ] || [ ! -f "$ort_include/onnxruntime_c_api.h" ]; then
  printf '%s\n' 'configure: onnxruntime_c_api.h was not found.' >&2
  printf '%s\n' 'Pass --onnxruntime-root or --onnxruntime-include.' >&2
  exit 2
fi
if [ -z "$ort_libdir" ] || ! find "$ort_libdir" -maxdepth 1 -name 'libonnxruntime.so*' -print -quit 2>/dev/null | grep -q .; then
  printf '%s\n' 'configure: libonnxruntime.so was not found.' >&2
  printf '%s\n' 'Pass --onnxruntime-root or --onnxruntime-libdir.' >&2
  exit 2
fi
if [ -z "$ort_library" ] || [ ! -f "$ort_library" ]; then
  printf '%s\n' 'configure: the ONNX Runtime shared library was not found.' >&2
  printf '%s\n' 'Pass --onnxruntime-library.' >&2
  exit 2
fi
if [ -z "$ort_soname" ] && command -v readelf >/dev/null 2>&1; then
  ort_soname=$(readelf -d "$ort_library" 2>/dev/null | sed -n 's/.*SONAME.*\[\(.*\)\].*/\1/p' | head -n 1)
fi
if [ -z "$ort_soname" ]; then
  ort_soname=$(basename "$ort_library")
fi
if [ "$backend" != cpu ] && [ -z "$runtime_library_path" ] && [ -n "${CONDA_PREFIX:-}" ]; then
  runtime_library_path=$(find "$CONDA_PREFIX"/lib/python*/site-packages -type f \( \
      -name 'libcudnn.so*' -o -name 'libcublas.so*' -o \
      -name 'libnvinfer.so*' -o -name 'libnvonnxparser.so*' \) \
      -printf '%h\n' 2>/dev/null | sort -u | paste -sd: -)
fi

temporary=config.mk.tmp
{
  printf '# Generated by ./configure. Do not edit; rerun configure instead.\n'
  printf 'FC := %s\n' "$fc"
  printf 'CC := %s\n' "$cc"
  printf 'BACKEND := %s\n' "$backend"
  printf 'PREFIX := %s\n' "$prefix"
  printf 'ONNXRUNTIME_INCLUDE := %s\n' "$ort_include"
  printf 'ONNXRUNTIME_LIBDIR := %s\n' "$ort_libdir"
  printf 'ONNXRUNTIME_LIBRARY := %s\n' "$ort_library"
  printf 'ONNXRUNTIME_SONAME := %s\n' "$ort_soname"
  printf 'RUNTIME_LIBRARY_PATH := %s\n' "$runtime_library_path"
} > "$temporary"
mv "$temporary" config.mk

printf '%s\n' 'FortONNX configuration:'
printf '  Fortran compiler: %s\n' "$fc"
printf '  backend:          %s\n' "$backend"
printf '  ORT include:      %s\n' "$ort_include"
printf '  ORT library:      %s\n' "$ort_libdir"
printf '  ORT library file: %s\n' "$ort_library"
printf '  ORT soname:       %s\n' "$ort_soname"
printf '  dependency paths: %s\n' "${runtime_library_path:-system default}"
printf '%s\n' 'Run make, then make test.'
